{
  "schema_version": 1,
  "contract_version": "1.0.0",
  "state": "defined",
  "activation": "inactive",
  "central_source": "lightning-it/.github",
  "functions": [
    {"id": "WF-01", "name": "local-quality", "runtime": "consumer", "depends_on": [], "failure": "block"},
    {"id": "WF-02", "name": "pr-quality-security", "runtime": "consumer", "depends_on": ["WF-01"], "failure": "block"},
    {"id": "WF-03", "name": "current-revision-review", "runtime": "consumer", "depends_on": ["WF-02"], "failure": "block"},
    {"id": "WF-04", "name": "promotion-pr", "runtime": "consumer", "depends_on": ["WF-02", "WF-03"], "failure": "block"},
    {"id": "WF-05", "name": "release-authorization", "runtime": "consumer", "depends_on": ["WF-04"], "failure": "block"},
    {"id": "WF-06", "name": "artifact-assurance-publication", "runtime": "consumer", "depends_on": ["WF-05"], "failure": "block"},
    {"id": "WF-07", "name": "release-audit-archive", "runtime": "consumer", "depends_on": ["WF-06"], "failure": "block"}
  ],
  "profiles": {
    "repository_profile": {"artifact_publication": false},
    "shared_assets": {"artifact_publication": false},
    "generic_managed": {"artifact_publication": "repository-policy"},
    "private_infrastructure": {"artifact_publication": "repository-policy"},
    "ansible_collection": {"artifact_publication": true},
    "container_image": {"artifact_publication": true},
    "terraform_module": {"artifact_publication": "repository-policy"},
    "terraform_policy": {"artifact_publication": "repository-policy"},
    "helm_chart": {"artifact_publication": true},
    "packer_template": {"artifact_publication": true},
    "playbook_runbook": {"artifact_publication": "repository-policy"},
    "documentation": {"artifact_publication": "repository-policy"}
  },
  "review": {
    "authority": "protected-base",
    "matrix": "existing-author-and-risk-policy",
    "release_app": "exact-revision-codex",
    "other_authors": "copilot-when-required-by-policy",
    "unclassified_input": "block",
    "local_ai_review": false,
    "dual_review": false,
    "budget_or_provider_failure": "block",
    "fallback": false,
    "reuse_stale_review": false,
    "request_identity": ["repository", "pull_request", "base_sha", "head_sha", "policy_sha", "input_digest"]
  },
  "promotion": {
    "source_branch": "develop",
    "target_branch": "main",
    "prepare_automatically": true,
    "single_flight": ["repository", "target_branch"],
    "grant_human_approval": false,
    "head_change_invalidates_checks": true
  },
  "authorization": {
    "classic_pr_approval_count": 0,
    "normal_environment": "normal-release-promotion-approval",
    "normal_human_approvals": 1,
    "normal_self_approval": true,
    "duplicate_approval_for_same_operation": false,
    "security_path": "existing-technical-authorization",
    "security_human_actions": 0,
    "administrative_bypass": false
  },
  "privacy": {
    "execution": "consumer-visibility",
    "credential_scope": "explicit-consumer-permissions",
    "inherit_all_secrets": false,
    "execute_candidate_for_authorization": false,
    "public_content": "pre-publication-validation",
    "private_tracker_metadata": "prohibited"
  },
  "evidence": {
    "develop": "native-checks-and-reviews",
    "durable_package": "main-promotion-only",
    "archive": "existing-private-s3-compatible-store",
    "retention_years": 7,
    "immutable_retention_required": true,
    "verify_artifact_before_release_acceptance": true,
    "archive_unavailable": "block-release-acceptance"
  },
  "rollout": {
    "stages": ["central-source-and-management", "private-distribution", "collection-reference", "additional-profiles", "remaining-fleet"],
    "reference_changes_without_correction": 3,
    "canary_required": true,
    "live_acceptance_required": true,
    "poc_until_scope_accepted": true,
    "rollback": "last-accepted-immutable-source"
  }
}
