{
  "version": 2,
  "base_ref": "refs/remotes/origin/develop",
  "checks": [
    {
      "name": "repository-quality-profile",
      "command": [
        "scripts/lit-ci-profile.sh",
        "repository-quality"
      ]
    }
  ],
  "remote_only_checks": [
    {
      "id": "github-actions-service-boundary",
      "workflow": ".github/workflows/repository-quality.yml",
      "job": "quality",
      "reason": "Checkout and artifact persistence require the GitHub Actions event and service context.",
      "owner": "Lightning IT Application Platform Maintainers"
    },
    {
      "id": "admitted-private-promotion-event",
      "workflow": ".github/workflows/delivery-operations.yml",
      "job": "prepare",
      "reason": "The immutable private event receiver needs the actual protected audit completion, independently accepted native ingress, exact current Develop and a target-bound Management dispatch. Unit fixtures grant no native source admission, review, approval or promotion acceptance.",
      "owner": "Lightning IT Application Platform Maintainers"
    }
  ],
  "review": {
    "warn_diff_bytes": 500000
  },
  "evidence": {
    "max_age_seconds": 86400
  },
  "agents": {
    "copilot": {
      "enabled": false,
      "required": false,
      "command": [
        "copilot"
      ],
      "timeout_seconds": 600
    },
    "codex": {
      "enabled": false,
      "required": false,
      "command": [
        "codex"
      ],
      "timeout_seconds": 900
    }
  }
}
